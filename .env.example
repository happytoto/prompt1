# 하나 이상 설정하세요. 여러 키는 쉼표로 구분(자동 로테이션·장애 시 다음 키로 전환)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# 선택: OmniRoute·LiteLLM 등 OpenAI 호환 게이트웨이
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=auto
CUSTOM_LABEL=내 게이트웨이

# 선택: 모델 변경(기본값은 lib/router.js)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
GROQ_MODEL=

# 선택: 전환 순서·운영값
PROVIDER_ORDER=anthropic,openai,gemini,openrouter,groq,custom
PROVIDER_TIMEOUT_MS=25000
KEY_COOLDOWN_MS=60000
RATE_LIMIT_PER_MIN=20
